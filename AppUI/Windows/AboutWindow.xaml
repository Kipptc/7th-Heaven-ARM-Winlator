<Window x:Class="AppUI.Windows.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AppUI.Windows"
        mc:Ignorable="d"
        Title="{Binding WindowTitle, FallbackValue='About 7th Heaven'}"
        Style="{StaticResource MainWindowStyle}"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ResizeMode="NoResize"
        Height="310"
        Width="520"
        MaxHeight="400">
    <Grid x:Name="gridMain" VerticalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>

        <Grid Visibility="{Binding DetailsVisibility, FallbackValue='Collapsed'}" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="txtTitle"
                       Margin="0,5,10,5"
                       FontSize="14"
                       TextWrapping="Wrap"
                       Text="{Binding Message, FallbackValue='The following mods are incompatible:'}" Grid.ColumnSpan="2"/>

            <TextBox x:Name="txtDetails"
                     Style="{StaticResource PrimaryTextBoxStyle}"
                     Grid.Row="1"
                     Margin="0,0,10,0"
                     TextWrapping="Wrap"
                     FontSize="14"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     IsReadOnly="True"
                     Background="Transparent"
                     VerticalAlignment="Stretch"
                     Text="{Binding Details, FallbackValue='Here are alot of details about stuff. Here are alot of details about stuff. Here are alot of details  about stuff. Here are alot of de tails about stuff. Here are alot of details about stuff. Here are alot of details about stuff. Here are alot of details about stuff. '}" Grid.ColumnSpan="2"/>


        </Grid>

        <TextBlock x:Name="txtMessage"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            Grid.Row="0"
            Padding="5,5,5,5"
            Foreground="{DynamicResource PrimaryControlForeground}"
            FontSize="14"
            TextWrapping="Wrap" Height="216"
        >
            7th Heaven ARM for Bannerlator v0.7.0 beta is an unofficial fork by Cyan. It adds Proton 11 ARM64 support, external FF7 shortcut launching, and extra diagnostic logging. This build is in early development; crashes may occur during normal use. It is provided as is without warranty.
            <LineBreak /><LineBreak />
            Based on <Hyperlink NavigateUri="https://github.com/tsunamods-codes/7th-Heaven" RequestNavigate="Hyperlink_RequestNavigate">7th Heaven by Tsunamods and contributors</Hyperlink>. Game driver: <Hyperlink NavigateUri="https://github.com/julianxhokaxhiu/FFNx/" RequestNavigate="Hyperlink_RequestNavigate">FFNx</Hyperlink>. See the included LICENSE.txt for the Microsoft Public License and the README for fork details and test setup.
        </TextBlock>

        <Button x:Name="btnClose"
            Click="btnClose_Click"
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
                
            Width="80"
            Content="{DynamicResource Close}"/>
    </Grid>
</Window>
